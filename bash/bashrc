# ~/.bashrc — bubblegum entry point
[ -z "$PS1" ] && return

# Ensure PATH covers ~/bin and ~/.local/bin
case ":$PATH:" in
  *":$HOME/bin:"*) ;;
  *) export PATH="$HOME/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Source modular configs
for f in ~/.config/shell/*.sh; do
  [ -r "$f" ] && source "$f"
done

# machine-local overrides, not tracked
[ -f ~/.bashrc.local ] && source ~/.bashrc.local

# keep crond alive
pgrep -f crond >/dev/null 2>&1 || crond 2>/dev/null || true
